# ---------------------------------------------------------------------------
# 依赖与构建产物：全部可再生，一律不入库
# ---------------------------------------------------------------------------
node_modules/
dist/
# `npm run build:fast` 的便携输出（可执行目录 + 随包资源）
dist-fast/
# 本地临时目录（验收脚本、探针、截图、日志）
.local/
debug.log
*.tsbuildinfo

# 后端 sidecar payload：`npm run server:package` 重新生成，只含构建输出
src-tauri/binaries/
# Tauri 自动生成的 ACL schema，`tauri dev` 会重写
src-tauri/gen/

# ---------------------------------------------------------------------------
# Python 记忆环境与字节码
# ---------------------------------------------------------------------------
.venv-memory/
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# 运行时状态：每次启动都会重写，不入库
# ---------------------------------------------------------------------------
# 开发版的 provisioning 状态写在仓库根；打包版写在 %APPDATA%\<identifier>
provisioning-state.json

# ---------------------------------------------------------------------------
# 引导页（初始化面板）负责下载的模型权重
# ---------------------------------------------------------------------------
# 这些是体积主体，且用户可以在面板里选任意目录下载，所以不入库。
# 仓库要装的是「下完模型就能跑」的运行时资产 —— VRM 角色 / VRMA 动作 / ASR 引擎与
# 两个 Silero VAD 导出，它们在文件类型层面保留跟踪，完整分工见 docs/provisioning.md。
/models/                            # 默认下载根：<仓库>/models
public/engines/sensevoice/*.data    # 229MB，是模型权重的重复副本，运行时被 offline-worker.js 的钩子跳过

# ---------------------------------------------------------------------------
# 本地生成 / 外部工具导出的中间物
# ---------------------------------------------------------------------------
public/assets/character/test/meshy/
public/assets/character/test/unity/*.fbx
public/assets/character/

# ---------------------------------------------------------------------------
# 注意：这里不再有 `[Vv][Rr][Mm]/` 这类整目录排除模式。
# 旧规则曾把 src/character/vrm/ —— 一个代码目录 —— 一起吞掉，使它长期未被跟踪；
# VRM/VRMA 现在是运行时资产，按文件类型交给 .gitattributes 声明为 binary 即可。
# ---------------------------------------------------------------------------
