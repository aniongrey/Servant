{
  "name": "character-drama-engine-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:fast": "node scripts/build-fast.mjs",
    "build:release": "tauri build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:fast": "tauri dev --no-watch --config src-tauri/tauri.fast.conf.json",
    "tauri:build": "npm run build:release",
    "desktop:serve": "vite build && vite preview --config vite.preview.config.ts --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "server:build": "vite build --config vite.server.config.ts",
    "server:package": "npm run server:build && node scripts/build-server-sea.mjs",
    "preview": "vite preview --config vite.preview.config.ts --host 0.0.0.0",
    "verify:chat": "node scripts/verify-chat.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "size:report": "node scripts/report-bundle-size.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/cohere": "^4.0.35",
    "@ai-sdk/deepseek": "^3.0.37",
    "@ai-sdk/google": "^4.0.59",
    "@ai-sdk/groq": "^4.0.35",
    "@ai-sdk/mistral": "^4.0.37",
    "@ai-sdk/openai": "^4.0.53",
    "@ai-sdk/xai": "^4.0.50",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@speech-sdk/core": "^0.29.0",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "ai": "^7.0.87",
    "lucide-react": "latest",
    "ollama-ai-provider-v2": "^4.0.1",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.185.1",
    "three-vrm-lip-sync": "^0.1.0",
    "toad-scheduler": "4.1.0",
    "undici": "^8.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.5",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "latest",
    "playwright": "^1.62.1",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^2.8.8",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "ws": "^8.21.3"
  }
}
